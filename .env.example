# DropQ environment. Copy to `.env` and fill in.
# Names only — never commit a real value. `pnpm env:check` reports the status of
# each name without printing any value, and is the fastest way to see what is
# missing for a given target.
#
# The app reads `.env` through Next.js in development only. In production every
# value must come from the process environment (Railway variables).

# --- database ---------------------------------------------------------------
# Postgres connection string. Required in production, and it must not point at
# localhost there. `pnpm db:deploy` applies migrations with it.
DATABASE_URL=

# --- session ----------------------------------------------------------------
# HMAC key for the session cookie. Required in production and must be at least
# 32 characters; a shorter one stops the server at boot. Generate with, for
# example: openssl rand -base64 48
SESSION_SECRET=

# --- Qloo -------------------------------------------------------------------
# API key. Without it the app still runs: pinned presets come from the cache and
# live generation answers with the friendly "demo is resting" message.
QLOO_API_KEY=
# Host override. Must stay on the allowlisted host; defaults to the hackathon host.
QLOO_BASE_URL=
# Requests contracted for the calendar month, used by our own usage counter.
QLOO_MONTHLY_LIMIT=
# Requests already spent against the same key before this deployment started
# counting (for example from a laptop). Subtracted from the monthly allowance.
QLOO_USED_BASELINE=
# Below this remaining count, custom (non-preset, non-cached) builds are refused;
# presets and cache keep working. Default 2000.
QLOO_CUSTOM_RESERVE=

# --- abuse and quota knobs (optional; defaults apply when empty) -------------
# Number of proxies that append to X-Forwarded-For in front of this app. The
# client address is taken this many entries from the right. Wrong values put
# every visitor in one bucket. Single Railway proxy: 1.
TRUSTED_PROXY_HOPS=
# Global soft cap on live (uncached) generations per rolling day. Default 250.
LIVE_GENERATIONS_PER_DAY=
# Above this many model calls per rolling hour, narration falls back to the
# template. Default 120.
LLM_CALLS_PER_HOUR=
# Pack cache TTL for ordinary (non-preset) requests, in hours. Default 24.
PACK_CACHE_TTL_HOURS=
# Intended freshness window for warmed preset rows, in hours. Default 72.
# Production tip: 720 (30 days) covers the judging window. A stored preset is
# still served to visitors after this window; re-warm after a PIPELINE_VERSION
# bump and once more after feature freeze.
PRESET_CACHE_TTL_HOURS=

# --- diagnostics ------------------------------------------------------------
# Temporary: "1" logs, for the first five requests only, how many
# X-Forwarded-For entries arrived and whether the derived client address looks
# private. Never logs an address. Off unless set.
LOG_IP_PROBE=

# --- LLM --------------------------------------------------------------------
# Kill switch: "true" or "1" turns the LLM off for the whole process (rule B
# anchors + template narration), regardless of the other LLM variables.
LLM_DISABLED=
# Provider: "google" or "nebius". Empty means the LLM is off, unless the three
# Nebius variables below are set, in which case Nebius is used.
LLM_PROVIDER=
# Required when LLM_PROVIDER=google only if GEMINI_MODEL is empty. There is no default model id.
LLM_MODEL=
# Google key. GEMINI_API_KEY is accepted when this one is empty.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
# Principal of the Gemini chain. When empty, LLM_MODEL is the principal. No default id:
# a model that appears in models.list can still return 404 on generateContent, so ids
# must come from the user's own verified list.
GEMINI_MODEL=
# Comma-separated ids tried after the principal. Empty entries and the principal are dropped.
GEMINI_FALLBACK_MODELS=
# Attempts per model. 0, empty and NaN use the default (3). The first backoff delay defaults to 1000.
GEMINI_RETRY_ATTEMPTS=
GEMINI_RETRY_DELAY_MS=
# Cap for one backoff sleep. Default 8000.
GEMINI_RETRY_MAX_DELAY_MS=
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODEL=
# Per-process cap on model calls. Empty means uncapped. Scripts set it for their
# own run (`pnpm warm`, the e2e harness).
DROPQ_LLM_BUDGET=

# --- scripts and harness only; the app never reads these ---------------------
# Local `qloo` CLI harness.
QLOO_TRUSTED_BASE_URL=
# `pnpm verify:local` target. Defaults to http://localhost:3000.
BASE_URL=
# `pnpm verify:ui`: port and base URL it starts its own server on. Defaults to 3311.
UI_PORT=
UI_BASE_URL=
# `pnpm probe:pass3d` call cap. Default 50.
PROBE_BUDGET=
# `pnpm smoke` only (optional). Values are confirmed from the Qloo docs after the key arrives.
SMOKE_BIAS_TRENDS=
SMOKE_POPULARITY_MAX=
# `pnpm e2e`: "local" (default) or "prod", and the base URL a prod run points at.
E2E_PROFILE=
E2E_BASE_URL=

# Not read in this pass.
# TAVILY_API_KEY=
# ELEVENLABS_API_KEY=
